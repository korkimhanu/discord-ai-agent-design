DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: comma-separated channel IDs where the bot replies without a mention.
DISCORD_AUTOREPLY_CHANNELS=

# Use either GitHub App credentials or a token.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=

# Optional. Leave empty when using logged-in CLI tools.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# API mode: DEFAULT_MODEL=auto, DEFAULT_AGENT=api
# Login/CLI mode: DEFAULT_MODEL=codex, DEFAULT_AGENT=codex
# Claude Code mode: DEFAULT_MODEL=claude-code, DEFAULT_AGENT=claude-code
DEFAULT_MODEL=codex
DEFAULT_AGENT=codex
CLAUDE_CODE_COMMAND=claude
CODEX_COMMAND=codex
WORKSPACE_ROOT=./workspaces
DATA_DIR=./.data
PUBLIC_BASE_URL=
