DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: comma-separated channel IDs where the bot replies without a mention.
DISCORD_AUTOREPLY_CHANNELS=

# Use either GitHub App credentials or a token.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=

# Optional. Leave empty when using logged-in CLI tools.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auto mode prefers logged-in Codex CLI, then Claude Code CLI, then API keys.
DEFAULT_MODEL=auto
DEFAULT_AGENT=auto
# API-only mode: DEFAULT_MODEL=auto, DEFAULT_AGENT=api
# Login/CLI fixed mode: DEFAULT_MODEL=codex, DEFAULT_AGENT=codex
# Claude Code mode: DEFAULT_MODEL=claude-code, DEFAULT_AGENT=claude-code
CLAUDE_CODE_COMMAND=claude
CODEX_COMMAND=codex
LOCAL_CHECKS=none
CI_POLL_SECONDS=180
WORKSPACE_ROOT=./workspaces
DATA_DIR=./.data
PUBLIC_BASE_URL=
